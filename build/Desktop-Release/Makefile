####### Compile

clickablelabel.o: ../../clickablelabel.cpp ../../clickablelabel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o clickablelabel.o ../../clickablelabel.cpp

converter.o: ../../converter.cpp ../../converter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o converter.o ../../converter.cpp

main.o: ../../main.cpp ../../mainwindow.h \
		../../converter.h \
		../../clickablelabel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		../../converter.h \
		../../clickablelabel.h \
		ui_mainwindow.h \
		../../settingsdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../../mainwindow.cpp

settingsdialog.o: ../../settingsdialog.cpp ../../settingsdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o settingsdialog.o ../../settingsdialog.cpp

qrc_qmake_qmake_qm_files.o: qrc_qmake_qmake_qm_files.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_qmake_qmake_qm_files.o qrc_qmake_qmake_qm_files.cpp

moc_clickablelabel.o: moc_clickablelabel.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_clickablelabel.o moc_clickablelabel.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_settingsdialog.o: moc_settingsdialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_settingsdialog.o moc_settingsdialog.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ConverterToJPEG/bin || mkdir -p $(INSTALL_ROOT)/opt/ConverterToJPEG/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/ConverterToJPEG/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/ConverterToJPEG/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/ConverterToJPEG/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ConverterToJPEG/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

